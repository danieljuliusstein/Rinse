    "admin:backfill-events": "node scripts/backfill-platform-events.mjs",
    "demo:setup": "node scripts/ensure-demo-account.mjs && FORCE_DEMO_PHOTOS=1 ORG_SLUG=summit-detail PB_EMAIL=demo@rinsehq.com PB_PASSWORD=SummitDemo2026! APP_URL=https://rinsehq.com node scripts/seed-demo.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "export:waitlist-assets": "node scripts/export-waitlist-assets.mjs",
    "verify:backend": "node scripts/verify-backend.mjs",
    "verify:stripe": "node scripts/verify-stripe.mjs",
    "test:stripe-connect": "node scripts/test-stripe-connect.mjs",
    "migrate:multi-tenant": "node scripts/migrate-to-multi-tenant.mjs",
    "test:isolation": "node scripts/isolation-test.mjs",
    "qa:walkthrough": "node scripts/qa-walkthrough.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/site-smoke.spec.ts",
    "test:e2e:flows": "playwright test e2e/flows",
    "test:e2e:tour": "playwright test e2e/product-tour.spec.ts",
    "test:e2e:ci": "npm run test:e2e:smoke && npm run test:e2e:tour",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "prepush": "node scripts/prepush.mjs",
    "prepush:full": "node scripts/prepush.mjs && npm run test:e2e:tour",
    "prepare": "husky"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.5.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.5.1",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^0.511.0",
    "motion": "^12.42.2",
    "motion-number": "^1.0.0",
    "next": "16.2.7",
    "nextjs-toploader": "^3.9.17",
    "pocketbase": "^0.27.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "resend": "^6.12.4",
    "stripe": "^22.3.0",
    "use-debounce": "^10.1.1",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
