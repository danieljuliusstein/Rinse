{
  "name": "detailing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=/tmp/detailing-app-next next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed:packages": "node scripts/seed-packages.mjs",
    "backfill:package-names": "node scripts/backfill-package-names.mjs",
    "verify:cron": "node scripts/verify-cron.mjs",
    "verify:features": "vitest run src/feature-verification/*.test.ts",
    "verify:features:core": "vitest run src/feature-verification/feature-verification.test.ts",
    "verify:features:domain": "vitest run src/feature-verification/deep-domain.test.ts",
    "verify:features:persistence": "vitest run src/feature-verification/persistence.test.ts",
    "verify:features:contracts": "vitest run src/feature-verification/external-contracts.test.ts",
    "verify:features:integration": "vitest run src/feature-verification/pocketbase-integration.test.ts",
    "verify:features:routes": "vitest run src/feature-verification/route-contract.test.ts",
    "verify:features:parity": "vitest run src/feature-verification/parity.test.ts",
    "verify:features:scan": "vitest run src/feature-verification/mock-scan.test.ts",
    "verify:features:adapters": "vitest run src/feature-verification/adapter-parity-scan.test.ts",
