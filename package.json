{
  "name": "detailing-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=tmp/detailing-app-next next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "seed:packages": "node scripts/seed-packages.mjs",
    "backfill:package-names": "node scripts/backfill-package-names.mjs",
