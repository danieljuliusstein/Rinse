    "motion": "^12.42.2",
    "next": "16.2.7",
    "pocketbase": "^0.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "stripe": "^22.3.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
