    "verify:stripe": "node scripts/verify-stripe.mjs",
    "test:stripe-connect": "node scripts/test-stripe-connect.mjs",
    "migrate:multi-tenant": "node scripts/migrate-to-multi-tenant.mjs",
    "test:isolation": "node scripts/isolation-test.mjs",
    "qa:walkthrough": "node scripts/qa-walkthrough.mjs",
    "generate:vapid": "node scripts/generate-vapid-keys.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/site-smoke.spec.ts",
    "test:e2e:flows": "playwright test e2e/flows",
    "test:e2e:tour": "playwright test e2e/product-tour.spec.ts",
    "test:e2e:ci": "npm run test:e2e:smoke && npm run test:e2e:tour",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
