{
  "name": "rinse-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sync-qa": "tsx scripts/sync-qa.ts",
    "native-smoke": "tsx scripts/native-smoke.ts",
    "money-parity": "tsx scripts/money-parity-test.ts",
    "follow-up-prefs": "tsx scripts/follow-up-prefs-test.ts",
    "visual-audit": "playwright test e2e/visual-audit.spec.ts --project=native-audit",
    "visual-audit:pwa": "playwright test e2e/visual-audit.spec.ts --project=pwa-parity",
    "visual-audit:all": "playwright test e2e/visual-audit.spec.ts",
    "visual-audit:update": "playwright test e2e/visual-audit.spec.ts --project=native-audit --update-snapshots",
    "capture-screens": "playwright test e2e/visual-audit.spec.ts --project=native-audit --update-snapshots",
    "visual-audit:update:pwa": "playwright test e2e/visual-audit.spec.ts --project=pwa-parity --update-snapshots",
    "visual-audit:ui": "playwright test e2e/visual-audit.spec.ts --ui",
    "visual-audit:install": "playwright install chromium",
    "motion-smoke": "playwright test e2e/motion-smoke.spec.ts --project=motion-smoke",
    "motion-smoke:capture": "MOTION_CAPTURE=1 playwright test e2e/motion-smoke.spec.ts --project=motion-smoke",
    "marketing:capture": "playwright test e2e/marketing-capture.spec.ts --project=marketing-capture",
    "marketing:export": "node scripts/export-waitlist-assets.mjs",
    "design:scrape": "node scripts/scrape-saas-design.mjs"
  },
