{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleSuffixes": [
      ".native",
      ".web",
      ""
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@rinse/core": [
        "../packages/core/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/**",
    "e2e/**",
    "playwright.config.mjs",
    "tests/**"
  ]
}
