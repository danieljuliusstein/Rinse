# Rinse Mobile — copy to .env (never commit .env)

# =============================================================================
# LOCAL WEB DEV (Expo web + signup / billing / VIN+plate OCR API routes)
# =============================================================================
# Metro proxies /api-proxy/* → EXPO_PUBLIC_APP_API_URL (see metro.config.js).
# Start API first: cd ../api && npm run dev  (port 3000)
# Plate/VIN photo OCR also needs OPENAI_API_KEY in apps/api/.env.local
#
# EXPO_PUBLIC_PB_URL=https://detailing-pb.fly.dev
# EXPO_PUBLIC_APP_API_URL=http://localhost:3000
# EXPO_PUBLIC_WEB_ORIGIN=https://rinsehq.com
#
# Restart Metro after changing .env (npm start in apps/mobile/).
#
# Dev: bypass onboarding gate entirely (optional)
# EXPO_PUBLIC_DEV_SKIP_ONBOARDING=1

# =============================================================================
# PRODUCTION (API + public site)
# =============================================================================
EXPO_PUBLIC_PB_URL=https://detailing-pb.fly.dev
EXPO_PUBLIC_APP_API_URL=https://rinsehq.com
EXPO_PUBLIC_WEB_ORIGIN=https://rinsehq.com

# =============================================================================
# TEST ORG (offline sync QA — required before destructive tests)
# =============================================================================
# Create a dedicated org against the API + PocketBase. Never run airplane-mode
# flush experiments against live client data.
#
# EXPO_PUBLIC_PB_URL=https://detailing-pb.fly.dev
# EXPO_PUBLIC_APP_API_URL=https://rinsehq.com
# EXPO_PUBLIC_TEST_EMAIL=your-qa-operator@example.com
# EXPO_PUBLIC_TEST_PASSWORD=your-local-password-only
#
# Dev sync QA on device/simulator (Settings → Simulate offline toggle):
# EXPO_PUBLIC_SYNC_QA_DEV=1
#
# Optional: Vercel preview for API routes on a branch
# EXPO_PUBLIC_APP_API_URL=https://your-preview.vercel.app
#
# See docs/native-sync-qa.md for the full airplane-mode test script.

# Kill switch — set to 0 to disable offline enqueue (online-only mode)
# EXPO_PUBLIC_OFFLINE_ENABLED=1

# App Store IAP — must match ASC auto-renewable subscription product id
# EXPO_PUBLIC_IAP_STARTER_PRODUCT_ID=com.rinse.mobile.starter.monthly

# EAS project (@danieljstein/rinse-mobile)
EAS_PROJECT_ID=a603bec9-0ac7-432a-b24a-9d100f9fd884

# Sentry — leave unset to disable crash reporting
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org
# SENTRY_PROJECT=rinse-mobile

# PostHog — product funnels only (billing/IAP truth = server platform_events)
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OAuth redirect (register in PocketBase + Google/Apple consoles):
# rinse://oauth/callback
