VITE_PB_URL=https://detailing-pb.fly.dev
# Optional local CORS-safe proxy (vite.config proxies /pb → PocketBase):
# VITE_PB_URL=/pb

# Detailing apps/api (geocode + OSRM trip for Calendar Route).
# Prefer Vite proxy so the browser stays same-origin:
# VITE_APP_API_URL=/app-api
# Or point at a running API:
# VITE_APP_API_URL=http://localhost:3000

# Google Places Autocomplete for Create/Edit Contact (US). Soft-capped at 50
# selections/day in-browser, then falls back to Nominatim via VITE_APP_API_URL.
# Enable "Places API (New)" + Maps JavaScript API; restrict key by HTTP referrer.
# Free monthly Maps credit (~$200) usually covers small CRM volume.
# VITE_GOOGLE_MAPS_API_KEY=

# Optional MapLibre style URL (defaults to Carto Voyager streets):
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/voyager-gl-style/style.json
# Avoid demotiles.maplibre.org (terrain only) and low-zoom OpenFreeMap (hillshade until city zoom).

# Optional campaign Resend mail service (base URL only — never put API keys here):
# VITE_CAMPAIGN_MAIL_URL=http://localhost:8787
